PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/edueval
GROQ_API_KEY=
# Optionnels : modèle Groq principal (défaut : openai/gpt-oss-120b),
# modèle de repli si le principal échoue de façon répétée (vide = pas
# de repli), délai de base du backoff entre deux tentatives en ms.
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GROQ_RETRY_BASE_DELAY_MS=
JWT_SECRET=
RESEND_API_KEY=
# Expéditeur des emails, ex. EduEval <no-reply@ton-domaine.com>. À RENSEIGNER
# avec un domaine vérifié sur Resend : sans lui, l'expéditeur de test
# (onboarding@resend.dev) n'envoie QU'À l'adresse du compte Resend, et les
# élèves comme les autres enseignants ne reçoivent rien.
RESEND_FROM_EMAIL=
# Optionnel : délai minimum entre deux envois, en ms (défaut : 200, soit 5
# emails/s pour une limite Resend de 10/s).
EMAIL_MIN_INTERVAL_MS=
CORS_ORIGIN=http://localhost:5173
# Optionnel : nombre maximum d'entrées d'élèves par IP et par 15 min
# (défaut : 1000). Une classe entière partage souvent une seule IP.
JOIN_RATE_LIMIT_PER_IP=
# Optionnel : taille du pool de connexions à la base (défaut : 20). À
# adapter aux limites de ton plan Postgres (Neon, etc.).
DATABASE_POOL_SIZE=
FRONTEND_URL=http://localhost:5173
# Stockage des fichiers déposés par les étudiants, via l'API S3 de
# Supabase Storage (ou tout autre fournisseur compatible S3 : R2,
# MinIO...). Requis pour /api/attempts/:id/answers/:questionId/file.
# Endpoint Supabase : https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
