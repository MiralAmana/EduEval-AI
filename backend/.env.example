PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/edueval
GROQ_API_KEY=
# Optionnels : modèle Groq principal (défaut : llama-3.3-70b-versatile),
# modèle de repli si le principal échoue de façon répétée (vide = pas
# de repli), délai de base du backoff entre deux tentatives en ms.
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GROQ_RETRY_BASE_DELAY_MS=
JWT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Stockage des fichiers déposés par les étudiants, via l'API S3 de
# Supabase Storage (ou tout autre fournisseur compatible S3 : R2,
# MinIO...). Requis pour /api/attempts/:id/answers/:questionId/file.
# Endpoint Supabase : https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
