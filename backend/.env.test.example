# Utilisé uniquement par `npm run test:integration`. Pointe vers une
# base Postgres dédiée aux tests, JAMAIS vers ta base de dev ou de prod
# (les tests suppriment leurs données à chaque exécution).
DATABASE_URL=postgresql://postgres:password@localhost:5433/edueval_test
JWT_SECRET=test-jwt-secret
FRONTEND_URL=http://localhost:5173
# Les tests d'intégration créent plusieurs comptes depuis la même IP
# dans une seule exécution ; la limite de prod (5/heure) les bloquerait.
AUTH_REGISTER_RATE_LIMIT=1000
